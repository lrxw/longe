{
  "name": "longe",
  "version": "0.1.2",
  "description": "Local-first board for tracking work done by AI coding agents: topics, decisions, and a question inbox, stored as markdown in your repo. MCP + REST + htmx UI.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "longe": "./bin/longe.js"
  },
  "files": [
    "bin",
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "packageManager": "pnpm@8.15.9",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^5.0.0",
    "hono": "^4.13.8",
    "htmx-ext-sse": "^2.2.4",
    "htmx.org": "2.0.4",
    "idiomorph": "^0.8.0",
    "markdown-it": "^15.0.2",
    "node-notifier": "^10.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "@types/node-notifier": "^8.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lrxw/longe.git"
  },
  "homepage": "https://github.com/lrxw/longe#readme",
  "bugs": {
    "url": "https://github.com/lrxw/longe/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "claude-code",
    "kanban",
    "board",
    "markdown",
    "local-first"
  ]
}
